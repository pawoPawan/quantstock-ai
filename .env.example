DATABASE_URL=postgresql://postgres:postgres@localhost:5432/quantstock
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-secret-key-here-minimum-32-chars
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional: OpenAI for AI insights
OPENAI_API_KEY=sk-...

# Optional: News API
NEWS_API_KEY=your-news-api-key

# Cache TTL (seconds)
CACHE_TTL_MARKET_DATA=60
CACHE_TTL_TECHNICAL=300
CACHE_TTL_FUNDAMENTAL=3600
CACHE_TTL_OPTIONS=120
